<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wear OS specific features -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Standalone wear app (no companion) -->
    <application
        android:name=".HermesWearApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HermesWear"
        tools:targetApi="34">

        <!-- Standalone wear app (works without phone companion) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!-- Main Activity (chat screen) -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HermesWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Voice Input Activity -->
        <activity
            android:name=".services.speech.VoiceInputActivity"
            android:exported="false"
            android:theme="@style/Theme.HermesWear" />

        <!-- Notification receiver for tap actions -->
        <service
            android:name=".services.notification.NotificationActionService"
            android:exported="false" />

        <!-- Wearable listener service for phone communication -->
        <service
            android:name=".services.websocket.WearableListenerServiceImpl"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.gms.wearable"
                android:resource="@xml/wearable_listener" />
        </service>

    </application>
</manifest>
